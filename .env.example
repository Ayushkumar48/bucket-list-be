DATABASE_URL=postgres://postgres:password@localhost:5432/bucket-list-be?sslmode=disable
PORT=8080

# Redis or Dragonfly connection URL
REDIS_URL=redis://localhost:6379/0

# Gmail SMTP with a Google App Password (not your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password

# Frontend route that reads ?token=... and POSTs it to the backend /auth/verify
MAGIC_LINK_URL=http://localhost:3000/auth/verify
